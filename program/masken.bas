10 REM MASKEN - FOR COMPUKIT UK101
20 REM STYR MED W A S D. RYMDEN = NY OMGANG.
30 W=PEEK(546)+1:B=PEEK(547)+256*PEEK(548)
40 NR=(PEEK(549)+256*PEEK(550)-B)/64+1
50 MX=200:DIM XX(200),YY(200)
60 HS=0
62 REM ---- TITEL ----
64 FOR I=1 TO NR:PRINT:NEXT
66 PRINT "  M A S K E N":PRINT
68 PRINT "  STYR MED  W  A  S  D":PRINT
70 PRINT "  ATA + GER LANGRE MASK":PRINT
72 PRINT "  VAGGEN OCH DIN EGEN KROPP DODAR":PRINT
74 PRINT "  RYMDEN STARTAR":SD=0
76 POKE 530,128:POKE 57088,253:K=PEEK(57088):POKE 530,0
78 SD=SD+1:IF (K AND 16)<>0 THEN 76
80 REM Vantetiden ger RND olika utgangslage varje gang. Utan detta hamnar
82 REM maten pa exakt samma stallen i varje korning.
84 FOR I=1 TO SD-INT(SD/17)*17:Z=RND(1):NEXT
100 REM ---- NY OMGANG ----
110 SC=0
115 REM CHR$(12) ar bara markor hem. Skarmen rensas genom att rullas, for
117 REM CEGMONS rullning ar maskinkod. Att POKE:a rent tar tio sekunder.
120 FOR I=1 TO NR:PRINT:NEXT
125 FOR I=0 TO W-1:POKE B+I,61:POKE B+(NR-1)*64+I,61:NEXT
130 FOR I=0 TO NR-1:POKE B+I*64,58:POKE B+I*64+W-1,58:NEXT
140 HX=INT(W/2):HY=INT(NR/2):DX=1:DY=0:HP=0:TP=1
150 FOR I=1 TO 5:HP=HP+1:XX(HP)=HX-5+I:YY(HP)=HY
160 POKE B+HY*64+XX(HP),42:NEXT
165 LN=0:REM LN = SEGMENT KVAR ATT VAXA
170 GOSUB 700
200 REM ---- HUVUDSLINGA ----
202 REM POKE 530,128 stanger BASICS brytkontroll. Utan den skriver den over
204 REM radvalet mellan POKE och PEEK, och matrisen las alltid fel.
206 POKE 530,128
208 REM Nastlad THEN IF duger inte i 8K BASIC, darfor AND med parenteser.
210 POKE 57088,239:K=PEEK(57088)
212 IF ((K AND 128)=0) AND (DY=0) THEN DX=0:DY=-1
220 POKE 57088,247:K=PEEK(57088)
222 IF ((K AND 128)=0) AND (DY=0) THEN DX=0:DY=1
230 IF ((K AND 64)=0) AND (DX=0) THEN DX=1:DY=0
240 POKE 57088,253:K=PEEK(57088)
242 IF ((K AND 64)=0) AND (DX=0) THEN DX=-1:DY=0
245 POKE 530,0
250 HX=HX+DX:HY=HY+DY:P=B+HY*64+HX:T=PEEK(P)
260 IF T=32 THEN 300
270 IF T<>43 THEN 500
280 SC=SC+1:LN=LN+3:GOSUB 700
300 POKE P,42:HP=HP+1:IF HP>MX THEN HP=1
310 XX(HP)=HX:YY(HP)=HY
320 IF LN>0 THEN LN=LN-1:GOTO 200
330 POKE B+YY(TP)*64+XX(TP),32:TP=TP+1:IF TP>MX THEN TP=1
340 GOTO 200
500 REM ---- SLUT ----
510 POKE P,88
520 IF SC>HS THEN HS=SC
530 M$="MASKEN DOG. LANGD"+STR$(SC)+"  BAST"+STR$(HS)
540 GOSUB 800
550 M$="RYMDEN FOR NY OMGANG"
560 P=B+64*(INT(NR/2)+1)+INT((W-LEN(M$))/2):GOSUB 810
570 POKE 530,128:POKE 57088,253:K=PEEK(57088):POKE 530,0
575 IF (K AND 16)<>0 THEN 570
580 GOTO 100
700 REM ---- LAGG MAT ----
710 FX=1+INT(RND(1)*(W-2)):FY=1+INT(RND(1)*(NR-2))
720 IF PEEK(B+FY*64+FX)<>32 THEN 710
730 POKE B+FY*64+FX,43:RETURN
800 P=B+64*INT(NR/2)+INT((W-LEN(M$))/2)
810 FOR I=1 TO LEN(M$):POKE P+I-1,ASC(MID$(M$,I,1)):NEXT:RETURN
