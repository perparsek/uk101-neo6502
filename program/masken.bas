10 REM MASKEN - FOR COMPUKIT UK101
20 REM S SVANGER VANSTER, D SVANGER HOGER, UR MASKENS EGET PERSPEKTIV
30 W=PEEK(546)+1:B=PEEK(547)+256*PEEK(548)
40 NR=(PEEK(549)+256*PEEK(550)-B)/64+1
50 MX=200:DIM XX(200),YY(200),VX(3),VY(3)
52 REM RIKTNING 0=HOGER 1=NED 2=VANSTER 3=UPP
54 VX(0)=1:VY(0)=0:VX(1)=0:VY(1)=1
56 VX(2)=-1:VY(2)=0:VX(3)=0:VY(3)=-1
58 RA=161:HU=226:KR=111:MA=231:DO=88
59 REM RA=block, HU=huvud, KR=kropp, MA=mat, DO=dodsmarke
60 HS=0
62 REM ---- TITEL ----
64 FOR I=1 TO NR:PRINT:NEXT
66 PRINT "  M A S K E N":PRINT
68 PRINT "  S SVANGER VANSTER":PRINT "  D SVANGER HOGER":PRINT
70 PRINT "  SVANGARNA GALLER UR MASKENS PERSPEKTIV":PRINT
72 PRINT "  ATA GER LANGRE MASK. VAGG OCH KROPP DODAR":PRINT
74 PRINT "  MELLANSLAG STARTAR":SD=0
76 POKE 530,128:POKE 57088,253:K=PEEK(57088):POKE 530,0
78 SD=SD+1:IF (K AND 16)<>0 THEN 76
80 REM Vantetiden ger RND olika utgangslage varje gang. Utan detta hamnar
82 REM maten pa exakt samma stallen i varje korning.
84 FOR I=1 TO SD-INT(SD/17)*17:Z=RND(1):NEXT
100 REM ---- NY OMGANG ----
110 SC=0
115 REM CHR$(12) ar bara markor hem. Skarmen rensas genom att rullas, for
117 REM CEGMONS rullning ar maskinkod. Att POKE:a rent tar tio sekunder.
120 FOR I=1 TO NR:PRINT:NEXT
125 FOR I=0 TO W-1:POKE B+I,RA:POKE B+(NR-1)*64+I,RA:NEXT
130 FOR I=0 TO NR-1:POKE B+I*64,RA:POKE B+I*64+W-1,RA:NEXT
140 HX=INT(W/2):HY=INT(NR/2):HD=0:HP=0:TP=1:Q1=0:Q2=0
150 FOR I=1 TO 5:HP=HP+1:XX(HP)=HX-5+I:YY(HP)=HY
160 POKE B+HY*64+XX(HP),KR:NEXT
162 POKE B+HY*64+HX,HU
165 LN=0:REM LN = SEGMENT KVAR ATT VAXA
170 GOSUB 700
200 REM ---- HUVUDSLINGA ----
202 REM POKE 530,128 stanger BASICS brytkontroll. Utan den skriver den over
204 REM radvalet mellan POKE och PEEK, och matrisen las alltid fel.
206 REM S och D ligger bada pa rad 3, sa en enda avlasning racker.
208 POKE 530,128:POKE 57088,247:K=PEEK(57088):POKE 530,0
210 P1=0:IF (K AND 128)=0 THEN P1=1
212 P2=0:IF (K AND 64)=0 THEN P2=1
214 REM Bara nytt nedslag svanger, annars skulle en hallen tangent snurra.
216 IF (P1=1) AND (Q1=0) THEN HD=HD+3-INT((HD+3)/4)*4
218 IF (P2=1) AND (Q2=0) THEN HD=HD+1-INT((HD+1)/4)*4
220 Q1=P1:Q2=P2
250 HX=HX+VX(HD):HY=HY+VY(HD):P=B+HY*64+HX:T=PEEK(P)
260 IF T=MA THEN 280
265 IF T<>32 THEN 500
270 GOTO 300
280 SC=SC+1:LN=LN+3:GOSUB 700
300 POKE B+YY(HP)*64+XX(HP),KR
310 POKE P,HU
320 HP=HP+1:IF HP>MX THEN HP=1
330 XX(HP)=HX:YY(HP)=HY
340 IF LN>0 THEN LN=LN-1:GOTO 200
350 POKE B+YY(TP)*64+XX(TP),32:TP=TP+1:IF TP>MX THEN TP=1
360 GOTO 200
500 REM ---- SLUT ----
510 POKE P,DO
520 IF SC>HS THEN HS=SC
530 M$="MASKEN DOG. ATIT"+STR$(SC)+"  BAST"+STR$(HS)
540 GOSUB 800
550 M$="MELLANSLAG FOR NY OMGANG"
560 P=B+64*(INT(NR/2)+1)+INT((W-LEN(M$))/2):GOSUB 810
570 POKE 530,128:POKE 57088,253:K=PEEK(57088):POKE 530,0
575 IF (K AND 16)<>0 THEN 570
580 GOTO 100
700 REM ---- LAGG MAT ----
710 FX=1+INT(RND(1)*(W-2)):FY=1+INT(RND(1)*(NR-2))
720 IF PEEK(B+FY*64+FX)<>32 THEN 710
730 POKE B+FY*64+FX,MA:RETURN
800 P=B+64*INT(NR/2)+INT((W-LEN(M$))/2)
810 FOR I=1 TO LEN(M$):POKE P+I-1,ASC(MID$(M$,I,1)):NEXT:RETURN
